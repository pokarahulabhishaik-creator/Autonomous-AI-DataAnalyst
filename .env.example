# AutoAnalyst AI - Environment Configuration Template
# Duplicate this file as `.env` for local development.
# For Streamlit Community Cloud, set these in App Settings -> Secrets.

# Default LLM Provider: 'auto', 'gemini', 'groq', or 'openai'
LLM_PROVIDER=auto

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq API
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
